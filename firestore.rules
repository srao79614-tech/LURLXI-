rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Diagnostic connection verification
    match /test/{docId} {
      allow read: if true;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Entity validation functions
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'name']) &&
             data.keys().hasOnly(['uid', 'email', 'name', 'selectedCategory', 'avatarUrl', 'isVip', 'role', 'createdAt', 'updatedAt']) &&
             data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 256 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             (!('selectedCategory' in data) || (data.selectedCategory is string && data.selectedCategory.size() <= 64)) &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 1024)) &&
             (!('isVip' in data) || data.isVip is bool) &&
             (!('role' in data) || (data.role is string && data.role.size() <= 64));
    }

    function isValidPerformance(data) {
      return data.keys().hasAll(['userId', 'overallMastery']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.overallMastery is number && data.overallMastery >= 0 && data.overallMastery <= 100 &&
             (!('totalMinutes' in data) || data.totalMinutes is number);
    }

    function isValidTrade(data) {
      return data.keys().hasAll(['id', 'userId', 'symbol', 'side', 'entryPrice']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.symbol is string && data.symbol.size() <= 32 &&
             data.side in ['BUY', 'SELL'] &&
             data.entryPrice is number &&
             (!('status' in data) || data.status in ['OPEN', 'CLOSED']) &&
             (!('amount' in data) || data.amount is number) &&
             (!('pnl' in data) || data.pnl is number);
    }

    function isValidWorldwideMessage(data) {
      return data.keys().hasAll(['id', 'userId', 'senderName', 'text']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.senderName is string && data.senderName.size() > 0 && data.senderName.size() <= 100 &&
             data.text is string && data.text.size() > 0 && data.text.size() <= 1000 &&
             (!('category' in data) || (data.category is string && data.category.size() <= 64));
    }

    function isValidThoughtPost(data) {
      return data.keys().hasAll(['id', 'userId', 'authorName', 'title', 'text']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 100 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.text is string && data.text.size() > 0 && data.text.size() <= 2500 &&
             (!('category' in data) || (data.category is string && data.category.size() <= 64)) &&
             (!('likes' in data) || data.likes is number);
    }

    // Match rules
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().uid == request.auth.uid;
      allow update: if isOwner(userId) && isValidUser(incoming()) && incoming().uid == existing().uid &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'selectedCategory', 'avatarUrl', 'isVip', 'role', 'updatedAt']);
      allow delete: if false;

      match /performance/{perfId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidPerformance(incoming()) && incoming().userId == request.auth.uid;
        allow delete: if isOwner(userId);
      }

      match /trades/{tradeId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidTrade(incoming()) && incoming().userId == request.auth.uid;
        allow delete: if isOwner(userId);
      }
    }

    match /worldwideChat/{messageId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(messageId) && isValidWorldwideMessage(incoming()) && incoming().userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /thoughtPosts/{postId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(postId) && isValidThoughtPost(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(postId) && existing().userId == request.auth.uid && incoming().userId == existing().userId &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'title', 'text']);
      allow delete: if isSignedIn() && isValidId(postId) && existing().userId == request.auth.uid;
    }
  }
}
